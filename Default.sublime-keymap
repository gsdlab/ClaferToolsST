[
    // Only in Clafer models, so that ctrl+i (incremental find) works in other files.
    {
        "keys": ["ctrl+i", "g", "a"],
        "command": "clafer_instances",
        "args": { "backend": "alloy" },
        "context": [{ "key": "selector", "operator": "equal", "operand": "source.clafer" }]
    },
    {
        "keys": ["ctrl+i", "g", "c"],
        "command": "clafer_instances",
        "args": { "backend": "choco" },
        "context": [{ "key": "selector", "operator": "equal", "operand": "source.clafer" }]
    }
]
